{
  "version": 2,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Full-corpus Kiwi C API search (automatic runtime)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MALMOI_WITH_E5": "OFF",
        "MALMOI_WITH_NATIVE_INDEX": "ON"
      }
    },
    {
      "name": "e5",
      "displayName": "Optional E5 semantic search",
      "inherits": "native",
      "binaryDir": "${sourceDir}/build/e5",
      "cacheVariables": {
        "MALMOI_WITH_E5": "ON",
        "MALMOI_WITH_NATIVE_INDEX": "OFF"
      }
    },
    {
      "name": "team",
      "displayName": "Default reverse search: TF-IDF + Kiwi BM25",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/team",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MALMOI_WITH_NATIVE_INDEX": "ON",
        "MALMOI_WITH_E5": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "e5",
      "configurePreset": "e5"
    },
    {
      "name": "team",
      "configurePreset": "team"
    }
  ]
}
