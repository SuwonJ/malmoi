# Pinned, Python-free runtime preparation. Large files stay out of Git.
set(MALMOI_DOWNLOAD_CACHE "${CMAKE_CURRENT_SOURCE_DIR}/artifacts/downloads" CACHE PATH "Verified release archive cache")
set(_runtime "${CMAKE_BINARY_DIR}/runtime")
function(malmoi_release_archive name url hash destination marker)
    if(EXISTS "${destination}/${marker}")
        return()
    endif()
    file(MAKE_DIRECTORY "${MALMOI_DOWNLOAD_CACHE}")
    set(archive "${MALMOI_DOWNLOAD_CACHE}/${name}")
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual)
        if(NOT actual STREQUAL hash)
            message(FATAL_ERROR "Cached release archive checksum mismatch: ${archive}")
        endif()
    else()
        message(STATUS "Downloading ${name}; first setup only")
        file(DOWNLOAD "${url}" "${archive}.part" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON SHOW_PROGRESS STATUS result)
        list(GET result 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Download failed: ${result}; rerun CMake after checking network access")
        endif()
        file(RENAME "${archive}.part" "${archive}")
    endif()
    file(MAKE_DIRECTORY "${destination}.staging")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}.staging")
    if(NOT EXISTS "${destination}.staging/${marker}")
        message(FATAL_ERROR "Release archive missing ${marker}")
    endif()
    file(RENAME "${destination}.staging" "${destination}")
endfunction()

